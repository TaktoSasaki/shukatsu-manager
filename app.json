{
  "expo": {
    "name": "就活管理",
    "slug": "shukatsu-manager",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shukatsu",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.shukatsumanager",
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.shukatsumanager",
      "permissions": [
        "RECORD_AUDIO",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withBackgroundActions",
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "面接音声を録音して文字起こしするためにマイクへのアクセスが必要です。"
        }
      ],
      "expo-file-system",
      [
        "expo-calendar",
        {
          "calendarPermission": "面接日をカレンダーに登録するためにカレンダーへのアクセスが必要です。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "QRコードを読み取ってマイページURLを登録するためにカメラへのアクセスが必要です。"
        }
      ]
    ]
  }
}
