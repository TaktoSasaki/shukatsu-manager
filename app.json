{
  "expo": {
    "name": "就活管理",
    "slug": "shukatsu-manager",
    "version": "1.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "shukatsu",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.shukatsumanager",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.shukatsumanager",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "./plugins/withBackgroundActions",
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-av",
        {
          "microphonePermission": "面接音声を録音して文字起こしするためにマイクへのアクセスが必要です。"
        }
      ],
      "expo-file-system",
      [
        "expo-calendar",
        {
          "calendarPermission": "面接日をカレンダーに登録するためにカレンダーへのアクセスが必要です。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "説明会アンケートなどのQRコードを読み取るためにカメラへのアクセスが必要です。"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a09267af-c1b3-4bc2-8740-d0fcda95ecc6"
      }
    },
    "owner": "salmiakki"
  }
}
